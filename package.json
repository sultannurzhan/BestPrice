    "@types/react-dom": "^19.1.7",
    "eslint": "9.35.0",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3"
  }

# Everything below is OPTIONAL. With no .env at all the app is fully functional:
# store discovery, scraping, matching and ranking are all deterministic code.
#
# Copy to .env.local to enable the language-model touches.

# OpenRouter key — https://openrouter.ai/keys
# Used for exactly two things:
#   1. understanding messy free-text queries ("cheapest 15 pro max 256 in white")
#   2. writing the one-line verdict above the results
# It never sees or changes a price, and every call falls back to rules on failure.
OPENROUTER_API_KEY=

# Any OpenRouter model id. Cheap and fast is the right trade-off here.
# Examples: openai/gpt-4o-mini, google/gemini-2.5-flash, anthropic/claude-haiku-4.5
OPENROUTER_MODEL=openai/gpt-4o-mini

# Sent to OpenRouter for attribution; harmless if left unset.
OPENROUTER_SITE_URL=http://localhost:3000

# Self-hosting behind a trusted reverse proxy only: set this to 1 after the
# proxy is configured to REMOVE client-supplied X-Forwarded-For/X-Real-IP and
# write its own values. Vercel and Cloudflare platform headers are recognized
# automatically. Leave disabled when exposing `next start` directly.
BESTPRICE_TRUST_PROXY=0
